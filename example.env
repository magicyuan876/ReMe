# LLM — required for auto_memory / auto_dream (memory distillation & consolidation).
LLM_API_KEY=sk-xxx
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# If Docker injects a corporate proxy, list hosts/IPs to reach DIRECTLY (e.g. a
# LAN model server), else the proxy intercepts those calls.
# REME_NO_PROXY=localhost,127.0.0.1,10.0.0.0/8

# Embeddings — OPTIONAL. Default retrieval is BM25 + wikilink (no embedding calls).
# To enable vector search set REME_EMBEDDING_STORE=default AND provide a key below.
# In multi-tenant mode the embedding client is shared; each tenant gets its own
# vector index. See docs/proposals/multi_tenant_docker_zh.md.
# REME_EMBEDDING_STORE=default
EMBEDDING_API_KEY=sk-xxx
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
